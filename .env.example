# ── App ───────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:8080
VITE_PUBLIC_APP_URL=http://localhost:8080
NODE_ENV=development
APP_ENV=development

# ── Database (TiDB Cloud) ─────────────────────────────────────────────────────
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# ── Auth (passwordless email OTP) ─────────────────────────────────────────────
JWT_SECRET=

# ── Email (Resend) — always platform sender ───────────────────────────────────
RESEND_API_KEY=
SMTP_FROM=Atleita <no-reply@disruptinglabs.com>

# ── Stripe (Mercado Pago stubbed/disabled in Atleita v1) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
VITE_STRIPE_TEST_PUBLISHABLE_KEY=
CRON_SECRET=
STRIPE_CHECKOUT_BUSINESS_NAME=Atleita
VITE_STRIPE_BUSINESS_DISPLAY_NAME=Atleita

# ── CDN uploads (optional) ────────────────────────────────────────────────────
CDN_UPLOAD_URL=
CDN_UPLOAD_SECRET=

# ── Client ────────────────────────────────────────────────────────────────────
VITE_APP_ENV=
VITE_DEFAULT_OG_IMAGE=
